Options +FollowSymLinks -MultiViews
Options -Indexes
RewriteEngine On
RewriteBase /

# Una sola variante pública por dominio; no altera las rutas de assets.
RewriteCond %{HTTP_HOST} ^(anatod\.(?:com\.ar|com\.mx|com|es|eus))$ [NC]
RewriteRule ^ https://www.%1%{REQUEST_URI} [R=301,L]

# Respeta HTTPS terminado en un proxy inverso.
RewriteCond %{HTTP_HOST} ^www\.anatod\.(?:com\.ar|com\.mx|com|es|eus)$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Conserva HTTPS en redirecciones cuando TLS termina en el proxy.
RewriteCond %{HTTP_HOST} ^www\.anatod\.(?:com\.ar|com\.mx|com|es|eus)$ [NC]
RewriteRule ^ - [E=ANATOD_ORIGIN:https://%{HTTP_HOST}]

RewriteCond %{THE_REQUEST} "\s/+index\.php(?:[?\s])" [NC]
RewriteRule ^index\.php$ %{ENV:ANATOD_ORIGIN}/ [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+software\.php(?:[?\s])" [NC]
RewriteRule ^software\.php$ %{ENV:ANATOD_ORIGIN}/software [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+about-us\.php(?:[?\s])" [NC]
RewriteRule ^about-us\.php$ %{ENV:ANATOD_ORIGIN}/about-us [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+contact-us\.php(?:[?\s])" [NC]
RewriteRule ^contact-us\.php$ %{ENV:ANATOD_ORIGIN}/contact-us [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+privacy-policy\.php(?:[?\s])" [NC]
RewriteRule ^privacy-policy\.php$ %{ENV:ANATOD_ORIGIN}/privacy-policy/ [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+terms-conditions\.php(?:[?\s])" [NC]
RewriteRule ^terms-conditions\.php$ %{ENV:ANATOD_ORIGIN}/terms-conditions/ [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+cookies-policy\.php(?:[?\s])" [NC]
RewriteRule ^cookies-policy\.php$ %{ENV:ANATOD_ORIGIN}/cookies-policy/ [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+legal-notice\.php(?:[?\s])" [NC]
RewriteRule ^legal-notice\.php$ %{ENV:ANATOD_ORIGIN}/legal-notice/ [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+kit-de-marca\.php(?:[?\s])" [NC]
RewriteRule ^kit-de-marca\.php$ %{ENV:ANATOD_ORIGIN}/kit-de-marca/ [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+fibra-optica\.php(?:[?\s])" [NC]
RewriteRule ^fibra-optica\.php$ %{ENV:ANATOD_ORIGIN}/ispkeeper/fibra-optica/ [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+wisp\.php(?:[?\s])" [NC]
RewriteRule ^wisp\.php$ %{ENV:ANATOD_ORIGIN}/ispkeeper/wisp/ [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+satelital\.php(?:[?\s])" [NC]
RewriteRule ^satelital\.php$ %{ENV:ANATOD_ORIGIN}/ispkeeper/satelital/ [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+internet-prepago\.php(?:[?\s])" [NC]
RewriteRule ^internet-prepago\.php$ %{ENV:ANATOD_ORIGIN}/ispkeeper/internet-prepago/ [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+telefonia-movil-fija-ip\.php(?:[?\s])" [NC]
RewriteRule ^telefonia-movil-fija-ip\.php$ %{ENV:ANATOD_ORIGIN}/ispkeeper/telefonia-movil-fija-ip/ [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+tv\.php(?:[?\s])" [NC]
RewriteRule ^tv\.php$ %{ENV:ANATOD_ORIGIN}/ispkeeper/tv/ [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+sepa\.php(?:[?\s])" [NC]
RewriteRule ^sepa\.php$ %{ENV:ANATOD_ORIGIN}/ispkeeper/sepa/ [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+api\.php(?:[?\s])" [NC]
RewriteRule ^api\.php$ %{ENV:ANATOD_ORIGIN}/ispkeeper/api/ [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+blog/index\.php(?:[?\s])" [NC]
RewriteRule ^blog/index\.php$ %{ENV:ANATOD_ORIGIN}/blog/ [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+events/index\.php(?:[?\s])" [NC]
RewriteRule ^events/index\.php$ %{ENV:ANATOD_ORIGIN}/events/ [R=301,L]
RewriteRule ^software/$ %{ENV:ANATOD_ORIGIN}/software [R=301,L]
RewriteRule ^about-us/$ %{ENV:ANATOD_ORIGIN}/about-us [R=301,L]
RewriteRule ^contact-us/$ %{ENV:ANATOD_ORIGIN}/contact-us [R=301,L]
RewriteRule ^privacy-policy$ %{ENV:ANATOD_ORIGIN}/privacy-policy/ [R=301,L]
RewriteRule ^terms-conditions$ %{ENV:ANATOD_ORIGIN}/terms-conditions/ [R=301,L]
RewriteRule ^cookies-policy$ %{ENV:ANATOD_ORIGIN}/cookies-policy/ [R=301,L]
RewriteRule ^legal-notice$ %{ENV:ANATOD_ORIGIN}/legal-notice/ [R=301,L]
RewriteRule ^kit-de-marca$ %{ENV:ANATOD_ORIGIN}/kit-de-marca/ [R=301,L]
RewriteRule ^ispkeeper/fibra-optica$ %{ENV:ANATOD_ORIGIN}/ispkeeper/fibra-optica/ [R=301,L]
RewriteRule ^ispkeeper/wisp$ %{ENV:ANATOD_ORIGIN}/ispkeeper/wisp/ [R=301,L]
RewriteRule ^ispkeeper/satelital$ %{ENV:ANATOD_ORIGIN}/ispkeeper/satelital/ [R=301,L]
RewriteRule ^ispkeeper/internet-prepago$ %{ENV:ANATOD_ORIGIN}/ispkeeper/internet-prepago/ [R=301,L]
RewriteRule ^ispkeeper/telefonia-movil-fija-ip$ %{ENV:ANATOD_ORIGIN}/ispkeeper/telefonia-movil-fija-ip/ [R=301,L]
RewriteRule ^ispkeeper/tv$ %{ENV:ANATOD_ORIGIN}/ispkeeper/tv/ [R=301,L]
RewriteRule ^ispkeeper/sepa$ %{ENV:ANATOD_ORIGIN}/ispkeeper/sepa/ [R=301,L]
RewriteRule ^ispkeeper/api$ %{ENV:ANATOD_ORIGIN}/ispkeeper/api/ [R=301,L]
RewriteRule ^blog$ %{ENV:ANATOD_ORIGIN}/blog/ [R=301,L]
RewriteRule ^events$ %{ENV:ANATOD_ORIGIN}/events/ [R=301,L]
RewriteRule ^blog/event/((?:[1-9][0-9]*_)?[a-z0-9-]+)/?$ %{ENV:ANATOD_ORIGIN}/evento/$1/ [R=301,L]
RewriteRule ^(evento/(?:[1-9][0-9]*_)?[a-z0-9-]+|blog/[0-9]{4}/[0-9]{2}/[0-9]{2}/[^/]+)$ %{ENV:ANATOD_ORIGIN}%{REQUEST_URI}/ [R=301,L]

RewriteRule ^sitemap\.xml$ /sitemap.php [L]
RewriteRule ^robots\.txt$ /robots.php [L]

RewriteRule ^evento/((?:[1-9][0-9]*_)?[a-z0-9-]+)/?$ /blog/event/index.php?slug=$1 [L,QSA]
RewriteRule ^blog/[0-9]{4}/[0-9]{2}/[0-9]{2}/[^/]+/?$ /blog/index.php [L]
RewriteRule ^blog/?$ /blog/index.php [L]
RewriteRule ^events/?$ /events/index.php [L]
RewriteRule ^about-us$ /about-us.php [L]
RewriteRule ^software$ /software.php [L]
RewriteRule ^contact-us$ /contact-us.php [L]
RewriteRule ^privacy-policy/?$ /privacy-policy.php [L]
RewriteRule ^terms-conditions/?$ /terms-conditions.php [L]
RewriteRule ^cookies-policy/?$ /cookies-policy.php [L]
RewriteRule ^legal-notice/?$ /legal-notice.php [L]

RewriteRule ^ispkeeper/fibra-optica/?$ /fibra-optica.php [L]
RewriteRule ^ispkeeper/wisp/?$ /wisp.php [L]
RewriteRule ^ispkeeper/satelital/?$ /satelital.php [L]
RewriteRule ^ispkeeper/internet-prepago/?$ /internet-prepago.php [L]
RewriteRule ^ispkeeper/telefonia-movil-fija-ip/?$ /telefonia-movil-fija-ip.php [L]
RewriteRule ^ispkeeper/tv/?$ /tv.php [L]
RewriteRule ^ispkeeper/sepa/?$ /sepa.php [L]
RewriteRule ^ispkeeper/api/?$ /api.php [L]
RewriteRule ^kit-de-marca/?$ /kit-de-marca.php [L]
