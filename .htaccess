Options +FollowSymLinks -MultiViews
Options -Indexes
RewriteEngine On
RewriteBase /

RewriteRule ^blog/event/([a-z0-9-]+)/?$ /blog/event/index.php?slug=$1 [L,QSA]
RewriteRule ^blog/[0-9]{4}/[0-9]{2}/[0-9]{2}/[^/]+/?$ /blog/index.php [L]
RewriteRule ^blog/?$ /blog/index.php [L]
RewriteRule ^events/?$ /events/index.php [L]
RewriteRule ^about-us$ /about-us.php [L]
RewriteRule ^software$ /software.php [L]
RewriteRule ^contact-us$ /contact-us.php [L]
RewriteRule ^privacy-policy/?$ /privacy-policy.php [L]
RewriteRule ^terms-conditions/?$ /terms-conditions.php [L]

RewriteRule ^ispkeeper/fibra-optica/?$ /fibra-optica.php [L]
RewriteRule ^ispkeeper/wisp/?$ /wisp.php [L]
RewriteRule ^ispkeeper/satelital/?$ /satelital.php [L]
RewriteRule ^ispkeeper/internet-prepago/?$ /internet-prepago.php [L]
RewriteRule ^ispkeeper/telefonia-movil-fija-ip/?$ /telefonia-movil-fija-ip.php [L]
RewriteRule ^ispkeeper/tv/?$ /tv.php [L]
RewriteRule ^ispkeeper/sepa/?$ /sepa.php [L]
RewriteRule ^ispkeeper/api/?$ /api.php [L]
RewriteRule ^kit-de-marca/?$ /kit-de-marca.php [L]
